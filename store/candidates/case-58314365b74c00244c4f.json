 "rules": [
  {
   "title": "复刻溢出菜单或 PopupMenu 宽度时用 constraintSize 写下限和上限，不写 width(196)",
   "product": "代码",
   "triggers": [
    {
     "read": "菜单 XML 的 <item> 带 showAsAction=\"never\"（进溢出菜单）或用 PopupMenu 弹出，标题是 @string/ 字符串资源；框架菜单项布局 abc_popup_menu_item_layout 写着 android:minWidth=\"196dip\"",
     "wrong": "自绘的菜单弹层或菜单行写成 .width(196)（或别的实测宽度），没有 maxWidth 上限，标题 Text 没有 maxLines(1)"
    }
   ],
   "scope": "把安卓溢出菜单、PopupMenu 复刻成 ArkUI 自绘弹层（不用系统 Menu/bindMenu）时，菜单宽度和菜单项标题的写法",
   "exceptions": [],
   "how": [
    {
     "text": "菜单容器写 .constraintSize({ minWidth: 196, maxWidth: Math.max(窗口宽 / 2, 320) })，宽度由最宽的菜单项撑开，不写 .width(N)",
     "support": [
      "case-58314365b74c00244c4f#recommendation:1",
      "case-58314365b74c00244c4f#diagnosis"
     ]
    },
    {
     "text": "菜单项标题 Text 加 .maxLines(1).textOverflow({ overflow: TextOverflow.Ellipsis })，长译文单行显示",
     "support": [
      "case-58314365b74c00244c4f#diagnosis"
     ]
    }
   ],
