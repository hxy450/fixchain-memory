   "rule": {
    "title": "源布局用 Start/End 边距时，目标写 start/end 的 LengthMetrics，不用物理键",
    "product": "代码",
    "triggers": [
     {
      "read": "源布局 XML 里有 android:paddingStart / android:paddingEnd / android:layout_marginStart / android:layout_marginEnd，或 layout_gravity=\"start\" / \"end\"",
      "wrong": "对应组件上写成 .padding({ left: …, right: … }) 或 .margin({ left: … }) / .margin({ right: … }) 这类物理键"
     }
    ],
    "scope": "源应用清单 android:supportsRtl=\"true\"（Start/End 在 RTL 下才镜像），把布局边距迁成 ArkUI 的 padding/margin 时",
    "exceptions": [],
    "how": [
     {
      "text": "源属性是 Start/End 的写 .padding({ top: LengthMetrics.vp(t), bottom: LengthMetrics.vp(b), start: LengthMetrics.vp(<paddingStart>), end: LengthMetrics.vp(<paddingEnd>) })，margin 同理用 start/end；只有源端只给 Left/Right 的地方才用 left/right",
      "support": [
       "case-927e26bb7b18f83f2f38#recommendation:1"
      ]
     },
     {
      "text": "写完后在目标文件里搜 left: 和 right:，逐条回对源 XML 那个属性是不是 Start/End",
      "support": [
       "case-927e26bb7b18f83f2f38#recommendation:1"
      ]
     }
    ],
    "values": [
     {
      "value": "padding(value: Padding | Length | LocalizedPadding): T；margin(value: Margin | Length | LocalizedMargin): T",
      "meaning": "padding/margin 同时接受物理键的 Padding/Margin 和逻辑键的 LocalizedPadding/LocalizedMargin",
      "source": "鸿蒙 SDK 的 ets/component/common.d.ts，CommonMethod.padding、CommonMethod.margin",
      "support": []
     },
     {
      "value": "LocalizedPadding { top?: LengthMetrics; end?: LengthMetrics; bottom?: LengthMetrics; start?: LengthMetrics }；LocalizedMargin = LocalizedPadding",
      "meaning": "逻辑键对象里四个边都是 LengthMetrics，改成 start/end 时 top/bottom 也要写成 LengthMetrics",
      "source": "鸿蒙 SDK 的 ets/component/units.d.ts，LocalizedPadding、LocalizedMargin",
      "support": []
     },
     {
      "value": "static vp(value: number): LengthMetrics",
      "meaning": "源端 dp 数值照搬成 vp",
      "source": "鸿蒙 SDK 的 ets/api/arkui/Graphics.d.ts，LengthMetrics.vp",
      "support": []
     },
     {
      "value": "方向类通用属性要支持镜像，用 start/end 入参类型替换 left/right、x/y",
      "meaning": "left/right 是绝对方向，RTL 下不镜像",
      "source": "arkts-internationalization.md，使用镜像能力 / 使用约束",
      "support": []
     },
     {
      "value": "paddingStart、paddingEnd、layout_marginStart、layout_marginEnd 的 format 是 dimension",
      "meaning": "源端是起始/结束边的尺寸，带 dp 单位",
      "source": "Android SDK 平台资源 data/res/values/attrs.xml，View 的 paddingStart、ViewGroup_MarginLayout 的 layout_marginEnd（按应用的 compileSdk 取对应平台）",
      "support": []
     },
     {
      "value": "safeAreaPadding(paddingValue: Padding | LengthMetrics | LocalizedPadding): T",
      "meaning": "同族接口：CommonMethod.safeAreaPadding 也接受 LocalizedPadding",
      "source": "鸿蒙 SDK 的 ets/component/common.d.ts，CommonMethod.safeAreaPadding",
      "support": []
     },
     {
      "value": "padding(value: Padding | Dimension | LocalizedPadding): BottomTabBarStyle",
      "meaning": "同族接口：BottomTabBarStyle 的内边距",
      "source": "鸿蒙 SDK 的 ets/component/tab_content.d.ts，BottomTabBarStyle.padding",
      "support": []
     }
    ],
    "lookups": [
     {
      "what": "源应用是否声明了 RTL 支持",
      "where": "源工程 AndroidManifest.xml 的 application 标签，按 android:supportsRtl 找",
      "how": "值为 true 时 Start/End 随布局方向解析；没写或 false 时安卓按 LTR 兼容模式解析"
     }
    ],
    "why": "写成 left/right 时 RTL 语言下边距不镜像，起始侧和结束侧的留白对调",
    "keys": {
     "read": [
      "android:paddingStart",
      "android:paddingEnd",
      "android:layout_marginStart",
      "android:layout_marginEnd",
      "layout_gravity",
      "android:supportsRtl"
     ],
     "product": [
      "padding",
      "margin",
      "LocalizedPadding",
      "LocalizedMargin",
      "LengthMetrics.vp",
      "start",
      "end",
      "left",
      "right"
     ]
    },
    "probe": {
     "pattern": "\\.(?:padding|margin)\\(\\s*\\{[^}]*\\b(?:left|right)\\s*:",
     "note": "padding/margin 用了物理键；回对源 XML，源端是 Start/End 的应改成 start/end 的 LengthMetrics"
    },
    "unverified": [
