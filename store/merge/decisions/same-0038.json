     {
      "value": "消息 TextView 用 ?android:attr/textAppearanceMedium；Theme.Holo 下是 TextAppearance.Holo.Medium → TextAppearance.Medium，textSize 18sp",
      "meaning": "消息字号",
      "source": "Android SDK 平台资源 data/res/layout/alert_dialog_holo.xml，message；themes_holo.xml、styles.xml，TextAppearance.Medium（按应用的 compileSdk 取对应平台）",
      "support": []
     },
     {
      "value": "dialog_min_width_minor = 95%，dialog_min_width_major = 65%",
      "meaning": "windowMinWidthMinor / Major：竖屏取窗口宽的 95%、横屏 65%",
      "source": "Android SDK 平台资源 data/res/values/dimens.xml，dialog_min_width_minor、dialog_min_width_major（按应用的 compileSdk 取对应平台）",
      "support": []
     },
     {
      "value": "params.dimAmount 取窗口主题的 backgroundDimAmount（缺省 0.5f）",
      "meaning": "变暗是窗口层的效果，浓度来自主题",
      "source": "com.android.internal.policy.PhoneWindow#generateLayout",
      "support": []
     },
     {
      "value": "Holo 面板单色 #282828，按钮条 53.33dp 带分隔线，两键两等分、单键占满；面板宽 = 窗口宽 ×（竖 0.95 / 横 0.65）− 32；两层对话框背景只暗一次 0.6",
      "meaning": "返修按平台资源与安卓实测取得的值",
      "source": "卡里修好并验证过",
      "support": [
       "case-ed0c3a60e7342aa867b4#diagnosis",
       "case-20015832edaeb45f53bb#diagnosis"
      ]
     }
    ],
    "lookups": [
     {
      "what": "应用主题继承的是哪个框架主题，以及它的对话框样式",
      "where": "源工程 AndroidManifest 的 android:theme，以及 res/values*/styles.xml（含 values-v11、values-v14）里这个主题的 parent 链；再到 Android SDK 平台资源 data/res/values/themes*.xml 找该平台主题的 alertDialogTheme、alertDialogStyle",
      "how": "顺着 windowTitleStyle → textAppearance、alertDialogStyle → layout 和面板 drawable、windowMinWidthMinor / Major → dimens、backgroundDimAmount 读出各项数值；例：Theme.Holo 下是 AlertDialog.Holo、alert_dialog_holo、0.6"
     }
    ],
    "why": "凭记忆或只看主题文件时，标题、框体、宽度、按钮排布和遮罩都和源端不一致",
