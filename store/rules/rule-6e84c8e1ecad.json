{
 "id": "rule-6e84c8e1ecad",
 "title": "源端在 Room onCreate 里播种时，目标把播种放进建表分支的同一事务，不用表为空判断",
 "product": "代码",
 "triggers": [
  {
   "read": "源端 RoomDatabase.Callback 的 onCreate(db) 里插入预置数据（首次建库才播种）",
   "wrong": "目标端初始化时每次打开都查 SELECT COUNT(*)，结果为 0 就调用播种函数"
  }
 ],
 "scope": "源端只在首次建库时播种预置数据，目标端用 relationalStore 的 RdbStore 自行建表和播种时",
 "exceptions": [],
 "how": [
  {
   "text": "播种放进建表分支（表都还不存在、要执行 CREATE TABLE 的那一支）的同一事务：beginTransaction() → executeSql(CREATE TABLE …) → insert 种子 → commit()",
   "support": [
    "case-b2793695ef65617c820a#recommendation:1",
    "case-b2793695ef65617c820a#diagnosis"
   ]
  },
  {
   "text": "不用「表为空」（COUNT(*) === 0）判断代替「首次创建」",
   "support": [
    "case-b2793695ef65617c820a#recommendation:1"
   ]
  }
 ],
 "values": [
  {
   "value": "播种移进「两表都不存在」的建表事务里，删光数据后重开不再重播种",
