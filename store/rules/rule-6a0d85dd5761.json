{
 "id": "rule-6a0d85dd5761",
 "title": "带 COALESCE 或子查询的 UPDATE 要返回行数时，先按同一 WHERE 计数再更新",
 "product": "代码",
 "triggers": [
  {
   "read": "源端 Room @Query 的 UPDATE 带 COALESCE(...) 等表达式或 WHERE id IN (子查询)，写不成 ValuesBucket，方法返回 Int",
   "wrong": "整条 SQL 交给 executeSql，再用 SELECT changes() 或依赖它的 helper 取行数"
  }
 ],
 "scope": "数据层实现阶段，SQL 不能直接写成 ValuesBucket + RdbPredicates、又要返回受影响行数的 UPDATE",
 "exceptions": [],
 "how": [
  {
   "text": "先用同一 WHERE 查出目标 id 或 count(*)（store.querySql('SELECT count(*) … WHERE …', args) 或查 id 列表），再用 RdbPredicates（如 .in(列, ids)）调 store.update 并返回数量",
   "support": [
