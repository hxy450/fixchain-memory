{
 "id": "rule-05f637585267",
 "title": "Column 换成 Scroll 时，尾部的 justifyContent/alignItems 移进内部 Column",
 "product": "代码",
 "triggers": [
  {
   "read": "原容器 `Column() {…}` 尾部挂着 `.layoutWeight(1).justifyContent(FlexAlign.Center).alignItems(HorizontalAlign.Center)` 一类的修饰链",
   "wrong": "换成 `Scroll() { Column() {…} }` 时只替换了容器头和子项，`.justifyContent(...)`、`.alignItems(...)` 落到了 Scroll 上，编译报 Property 'justifyContent' does not exist on type 'ScrollAttribute'"
  }
 ],
 "scope": "ArkUI 页面替换容器类型（Column/Row 换成 Scroll 等非线性容器）时",
 "exceptions": [],
 "how": [
  {
   "text": "把原容器尾部整条修饰链纳入同一处修改，逐项核对新容器是否支持",
   "support": [
    "case-c839a6e432779939bf8b#recommendation:1",
    "case-c839a6e432779939bf8b#diagnosis"
   ]
  },
  {
   "text": "Column/Row 专属的 `.justifyContent(...)`、`.alignItems(...)` 移到 Scroll 内部的 Column 上或删除，Scroll 上只保留 `.layoutWeight(1)` 等通用属性",
   "support": [
    "case-c839a6e432779939bf8b#recommendation:1",
    "case-c839a6e432779939bf8b#diagnosis"
   ]
  }
 ],
 "values": [
  {
   "value": "justifyContent(value: FlexAlign): ColumnAttribute",
   "meaning": "Column 的主轴（竖直）对齐，属于 ColumnAttribute",
   "source": "鸿蒙 SDK 的 ets/component/column.d.ts，ColumnAttribute.justifyContent",
   "support": []
  },
  {
   "value": "alignItems(value: HorizontalAlign): ColumnAttribute",
   "meaning": "Column 的交叉轴（水平）对齐，属于 ColumnAttribute",
   "source": "鸿蒙 SDK 的 ets/component/column.d.ts，ColumnAttribute.alignItems",
   "support": []
  },
  {
   "value": "justifyContent(value: FlexAlign): RowAttribute；alignItems(value: VerticalAlign): RowAttribute",
   "meaning": "同族接口：Row 的两种对齐，交叉轴参数是 VerticalAlign",
   "source": "鸿蒙 SDK 的 ets/component/row.d.ts，RowAttribute.justifyContent / RowAttribute.alignItems",
   "support": []
  },
  {
   "value": "justifyContent?: FlexAlign",
   "meaning": "同族接口：Flex 的主轴对齐写在构造参数 FlexOptions 里，不是属性方法",
   "source": "鸿蒙 SDK 的 ets/component/flex.d.ts，FlexOptions.justifyContent",
   "support": []
  },
  {
   "value": "Scroll 上写 justifyContent 编译报 Property 'justifyContent' does not exist on type 'ScrollAttribute'；删掉后保留 layoutWeight 编译通过",
   "meaning": "Scroll 不支持这两个对齐属性",
   "source": "卡里修好并验证过",
   "support": [
    "case-c839a6e432779939bf8b#diagnosis"
   ]
  }
 ],
