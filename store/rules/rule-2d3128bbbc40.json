{
 "id": "rule-2d3128bbbc40",
 "title": "源端非手势导航时给导航栏着色的，入口按 TYPE_SYSTEM 底部高度判断后着色",
 "product": "代码",
 "triggers": [
  {
   "read": "源 Activity 里 if (!isUsingGestures) setNavigationBarColor(…) 给三键导航栏着色",
   "wrong": "EntryAbility 的 setWindowSystemBarProperties 里 navigationBarColor 恒为 '#00000000'，没有导航方式判断"
  }
 ],
 "scope": "迁移入口窗口的系统栏着色、源端按导航方式区分时",
 "exceptions": [],
 "how": [
  {
   "text": "取 win.getWindowAvoidArea(window.AvoidAreaType.TYPE_SYSTEM)，usingGestures = bottomRect.height === 0；非手势时 setWindowSystemBarProperties({ navigationBarColor: <源端颜色含透明度> })",
   "support": [
    "case-01833db0536ba02ed2ce#diagnosis",
    "case-01833db0536ba02ed2ce#recommendation:1"
   ]
  },
  {
   "text": "在 win.on('avoidAreaChange', …) 里重新判断并着色，响应导航方式切换",
   "support": [
    "case-01833db0536ba02ed2ce#diagnosis",
    "case-01833db0536ba02ed2ce#recommendation:2"
   ]
  }
 ],
 "values": [
