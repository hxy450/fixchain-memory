   "source": "鸿蒙 SDK 的 ets/api/@ohos.window.d.ts，SystemBarProperties.navigationBarColor",
   "support": []
  },
  {
   "value": "setWindowSystemBarProperties(systemBarProperties: SystemBarProperties): Promise<void>",
