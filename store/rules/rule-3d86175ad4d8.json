{
 "id": "rule-3d86175ad4d8",
 "title": "源布局指定字体文件时，注册 rawfile 字体并在 Text 上写 fontFamily",
 "product": "代码",
 "triggers": [
  {
   "read": "源布局 TextView 上有 `pixlui:typeface`（指向 ttf 文件）或 `android:fontFamily`",
   "wrong": "对应 Text 没有 `.fontFamily(...)`，字体名只写在注释里；粗体字体用 `.fontWeight(FontWeight.Bold)` 伪粗体代替"
  }
 ],
 "scope": "源端用自定义字体文件（pixlui 或 fontFamily）的文本迁到 ArkUI Text、Span 时",
 "exceptions": [],
 "how": [
  {
   "text": "确认 ttf 已在 resources/rawfile/fonts 下；在页面 aboutToAppear 里注册：this.getUIContext().getFont().registerFont({ familyName: '<字体名>', familySrc: $rawfile('fonts/<文件名>.ttf') })",
   "support": [
    "case-9cfde635e67a08373fe6#recommendation:2"
   ]
  },
  {
   "text": "在每个对应 Text 上写 .fontFamily('<字体名>')；粗体字体文件单独注册成一个族来用，不用 fontWeight(Bold) 代替字体族",
   "support": [
    "case-9cfde635e67a08373fe6#recommendation:2",
    "case-9cfde635e67a08373fe6#diagnosis"
   ]
  }
 ],
 "values": [
  {
   "value": "registerFont(options: font.FontOptions): void",
   "meaning": "UIContext 的 Font 对象注册自定义字体（经 getFont(): Font 取得）",
   "source": "鸿蒙 SDK 的 ets/api/@ohos.arkui.UIContext.d.ts，Font.registerFont、UIContext.getFont",
   "support": []
  },
  {
   "value": "familyName: string | Resource；familySrc: string | Resource",
   "meaning": "FontOptions 的两项：注册的字体名、字体文件路径",
   "source": "鸿蒙 SDK 的 ets/api/@ohos.font.d.ts，FontOptions",
   "support": []
  },
  {
   "value": "font.registerFont 标了 @deprecated since 18，改用 UIContext.Font#registerFont",
   "meaning": "不要再用 @ohos.font 的全局 registerFont",
   "source": "鸿蒙 SDK 的 ets/api/@ohos.font.d.ts，font.registerFont",
   "support": []
  },
  {
   "value": "fontFamily(value: string | Resource): TextAttribute",
   "meaning": "Text 的字体族，传注册时的 familyName",
   "source": "鸿蒙 SDK 的 ets/component/text.d.ts，TextAttribute.fontFamily",
   "support": []
  },
  {
   "value": "fontFamily(value: string | Resource): SpanAttribute",
   "meaning": "同族接口：Span 的字体族",
   "source": "鸿蒙 SDK 的 ets/component/span.d.ts，SpanAttribute.fontFamily",
   "support": []
  },
  {
   "value": "fontFamily(value: ResourceStr): TextInputAttribute",
   "meaning": "同族接口：TextInput 的字体族",
   "source": "鸿蒙 SDK 的 ets/component/text_input.d.ts，TextInputAttribute.fontFamily",
   "support": []
  },
  {
   "value": "注册 rawfile/fonts 下的字体并在 Text 上写 fontFamily 后，字形与源端一致",
   "meaning": "验证过的写法",
   "source": "卡里修好并验证过",
   "support": [
    "case-9cfde635e67a08373fe6#diagnosis"
   ]
  }
 ],
 "lookups": [
  {
   "what": "每个文本用哪个字体文件",
   "where": "源布局 XML 里各 TextView 的 pixlui:typeface / android:fontFamily，以及它们引用的 style；源工程的 assets 或 res/font 下的字体文件",
   "how": "按控件逐个记下字体文件名，确认目标 rawfile/fonts 下有同名文件"
  }
 ],
 "why": "不注册、不写 fontFamily 时用系统字体，伪粗体也和源端的粗体字形不同",
