{
 "id": "rule-379448cfe28c",
 "title": "styles 父链止于平台主题时，规格里的文字色先在 SDK 平台资源解析到值，不写「暗底白字」",
 "product": "规格",
 "triggers": [
  {
   "read": "源 styles 的 parent 链止于 android:Theme.Holo / Theme.Material / Theme.DeviceDefault，文字控件只写 textAppearanceLarge / Medium / Small，或既不写 textColor 也不写 textAppearance；EditText 没写 textColorHint",
   "wrong": "规格写「文字色（Theme.Holo 暗底白字）| 显式 .fontColor('#FFFFFF')」这类概括，或把次色、提示色写成半透明白并标「待核」"
  }
 ],
 "scope": "规格里为没有显式颜色的文字控件写转换决策行时，颜色由 Android 平台主题提供",
 "exceptions": [],
 "how": [
  {
   "text": "按主题 textColorPrimary / textColorSecondary / textColorHint → color/ 下的 selector（如 primary_text_holo_dark.xml，取默认项）→ values/colors_holo.xml 的顺序解析到具体色值，写进各控件的决策行",
   "support": [
    "case-e6fd5f0c4d37710c1d97#recommendation:1"
   ]
  },
  {
   "text": "逐个控件按来源写：textAppearanceLarge / Medium 取主色；textAppearanceSmall，或既无 textColor 也无 textAppearance 的 TextView 取次色；EditText 没写 textColorHint 取提示色；源端显式写的颜色照写显式值",
   "support": [
    "case-e6fd5f0c4d37710c1d97#recommendation:2",
    "case-e6fd5f0c4d37710c1d97#diagnosis"
   ]
  }
 ],
 "values": [
  {
   "value": "Theme.Holo：textColorPrimary = @color/primary_text_holo_dark，textColorSecondary = @color/secondary_text_holo_dark，textColorHint = @color/hint_foreground_holo_dark",
   "meaning": "Holo 暗色主题的三种文字色引用",
   "source": "Android SDK 平台资源 data/res/values/themes_holo.xml，Theme.Holo 的 textColorPrimary 等（按应用的 compileSdk 取对应平台）",
   "support": []
