   "source": "Android SDK 平台资源 data/res/values/styles.xml，Widget.TextView、TextAppearance.Small（按应用的 compileSdk 取对应平台）",
   "support": []
  },
  {
   "value": "TextAppearance：textColor = ?textColorPrimary；TextAppearance.Large、TextAppearance.Medium 只改 textSize",
