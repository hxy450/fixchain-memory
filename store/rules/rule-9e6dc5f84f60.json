 "lookups": [],
 "why": "对 class 写 implements 时 ArkTS 编译失败；禁止 worker 编译的流程里错误要到下一轮编译门才暴露",
 "keys": {
  "read": [
   "errorManager",
   "ErrorObserver",
   "errorManager.on",
   "onUnhandledException",
   "onException",
   "export default class",
   "UncaughtExceptionHandler"
  ],
  "product": [
   "implements",
   "errorManager.ErrorObserver",
   "arkts-implements-only-iface",
   "errorManager.on",
   "errorManager.off",
   "onUnhandledException"
  ]
 },
 "probe": {
  "pattern": "implements\\s+[\\w.]*(ErrorObserver|ApplicationStateObserver|AbilityStartCallback)\\b",
  "note": "对 SDK 里声明为 class 的观察者写了 implements，应改成标注该类型的对象字面量"
 },
 "unverified": [
