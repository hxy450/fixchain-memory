{
 "id": "rule-fe06f7b6fbfd",
 "title": "标题栏溢出钮按 Material 溢出钮样式分侧取内距，不按最小宽对称近似",
 "product": "代码",
 "triggers": [
  {
   "read": "源主题是 Theme.Material 系的窗口 ActionBar，菜单有进溢出的项",
   "wrong": "溢出钮按 action_button_min_width_overflow_material 对称取左右 padding"
  }
 ],
 "scope": "自绘标题栏还原 Material 窗口 ActionBar 的溢出钮时",
 "exceptions": [],
 "how": [
  {
   "text": "溢出钮宽 = actionOverflowButtonStyle 的 paddingStart + 图标宽 + paddingEnd，左右分别写，不取对称值",
   "support": [
    "case-45b40cf92799928188ab#recommendation:5"
   ]
  }
 ],
 "values": [
  {
   "value": "Widget.Material.ActionButton.Overflow：paddingStart=@dimen/action_bar_overflow_padding_start_material（6dp），paddingEnd=@dimen/action_bar_overflow_padding_end_material（10dp），minWidth=36dp",
   "meaning": "溢出钮左右内距不对称",
   "source": "Android SDK 平台资源 data/res/values/styles_material.xml，Widget.Material.ActionButton.Overflow；data/res/values/dimens_material.xml（按应用的 compileSdk 取对应平台）",
   "support": []
  }
 ],
 "lookups": [
