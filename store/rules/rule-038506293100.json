  }
 ],
 "scope": "复刻框架 AlertDialog 或 DialogPreference 的标题时",
 "exceptions": [],
 "how": [
  {
   "text": "标题先按标题字号单行排；单行放不下（会出省略号）时改用 textAppearanceMedium 的字号并 .maxLines(2)（Material 主题下即 20fp 放不下改 18fp 两行），做成共享的标题组件供各对话框复用",
   "support": [
    "case-5b8257f101e304280326#diagnosis",
    "case-5b8257f101e304280326#recommendation:2"
   ]
  }
 ],
 "values": [
  {
   "value": "DialogTitle.onMeasure：最后一行有省略时 setSingleLine(false)、setMaxLines(2)，字号改取 textAppearanceMedium 的 textSize",
   "meaning": "singleLine 只是初值，框架运行期会改成两行小一号",
   "source": "com.android.internal.widget.DialogTitle#onMeasure",
   "support": []
  },
  {
   "value": "改成标题组件「20fp 放不下切 18fp 两行」后与源端一致",
   "meaning": "Material 主题下的修法",
   "source": "卡里修好并验证过",
   "support": [
    "case-5b8257f101e304280326#diagnosis"
   ]
  }
 ],
 "lookups": [
  {
   "what": "标题字号和放不下时的中号字号",
   "where": "Android SDK 平台资源 data/res/values/themes_material.xml（或应用主题链）里对话框主题的 windowTitleStyle 和 textAppearanceMedium，再到 styles_material.xml、dimens_material.xml 解析到 textSize",
   "how": "读出两个 sp 值，目标写成同值 fp。例：Material 主题下 textAppearanceMedium → TextAppearance.Material.Medium → text_size_medium_material 18sp，标题 text_size_title_material 20sp"
  }
 ],
