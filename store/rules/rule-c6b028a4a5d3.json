 "product": "代码",
 "triggers": [
  {
   "read": "源端通知帮助类以固定 ID、setOngoing(true) 发布常驻通知，cancel 只在关闭开关时调用",
   "wrong": "通知更新写在页面 ViewModel 的回调里，页面 aboutToDisappear 里移除回调、停止观察；冷启动时偏好开着也不恢复监听"
  }
 ],
 "scope": "目标端实现由开关控制、由设备事件驱动的常驻通知时",
 "exceptions": [],
 "how": [
  {
   "text": "写一个应用级单例通知服务，提供 setEnabled / restore / reconcile / release；在能力装配处 restore（偏好开启就常驻监听），回到前台时 reconcile 复核系统许可",
   "support": [
    "case-2bb1f7385338bea7e396#recommendation:2",
    "case-2bb1f7385338bea7e396#diagnosis"
   ]
  },
  {
   "text": "事件到达时用 notificationManager.publish({ id: <固定 ID>, isOngoing: true, … }) 以同一 ID 更新；页面 ViewModel 只转发开关动作，aboutToDisappear 不释放通知所需的订阅，release 不撤销通知",
   "support": [
    "case-2bb1f7385338bea7e396#recommendation:2",
    "case-2bb1f7385338bea7e396#diagnosis"
   ]
  }
 ],
