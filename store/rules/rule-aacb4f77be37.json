{
 "id": "rule-aacb4f77be37",
 "title": "组件内取字符串资源用 getHostContext() 判空后取 resourceManager",
 "product": "代码",
 "triggers": [
  {
   "read": "源端 activity.getString(R.string.…) / getResources().getString(…) 拼进文本或 setContentDescription",
