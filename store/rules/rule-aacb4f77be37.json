  }
 ],
 "scope": "在组件里解析字符串资源时",
 "exceptions": [],
 "how": [
  {
   "text": "链式调用逐跳核对：const ctx = this.getUIContext().getHostContext(); 为 undefined 时走兜底（如返回空串），否则 ctx.resourceManager.getStringSync($r('app.string.…'))",
   "support": [
