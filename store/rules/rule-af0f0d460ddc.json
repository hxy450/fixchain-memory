{
 "id": "rule-af0f0d460ddc",
 "title": "Camera2 ISO 上下限迁到 getSupportedIsoRange 时过滤正值排序取首尾",
 "product": "代码",
 "triggers": [
  {
   "read": "源端 CameraCharacteristics.SENSOR_INFO_SENSITIVITY_RANGE（Range<Integer> 上下限）",
   "wrong": "把 getSupportedIsoRange() 返回值的 iso[0]、iso[1] 当最小、最大 ISO"
  }
 ],
 "scope": "把 Camera2 ISO 能力迁到 HarmonyOS 相机会话的 ManualIso（文档标 API 24+）时",
 "exceptions": [],
 "how": [
  {
   "text": "getSupportedIsoRange() 的结果过滤出正值、升序排序，取第一个作最小 ISO、最后一个作最大 ISO；setIso 的值取自这个列表",
   "support": [
    "case-aa27ff1b39767c02b1ec#recommendation:2",
    "case-aa27ff1b39767c02b1ec#diagnosis"
   ]
  }
 ],
 "values": [
  {
   "value": "getSupportedIsoRange(): number[]：获取支持的标准ISO感光度值数组",
   "meaning": "返回离散的标准值列表，不是 [min, max]",
   "source": "arkts-apis-camera-ManualIsoQuery.md，getSupportedIsoRange",
   "support": []
  },
  {
   "value": "setIso(iso: number): void，设置的值需在 getSupportedIsoRange 范围内",
   "meaning": "ManualIso 下发 ISO",
   "source": "arkts-apis-camera-ManualIso.md，setIso",
   "support": []
  },
  {
   "value": "SENSOR_INFO_SENSITIVITY_RANGE: Range<Integer>，取值是标准 ISO 感光度",
   "meaning": "源端是上下限",
   "source": "android.hardware.camera2.CameraCharacteristics#SENSOR_INFO_SENSITIVITY_RANGE",
   "support": []
  },
  {
   "value": "ISO 取正值排序后的首尾",
   "meaning": "修好的写法",
   "source": "卡里修好并验证过",
   "support": [
    "case-aa27ff1b39767c02b1ec#diagnosis"
   ]
  }
 ],
 "lookups": [],
 "why": "把离散列表的前两项当上下限，ISO 滑杆的范围只剩最低的两档",
 "keys": {
  "read": [
   "SENSOR_INFO_SENSITIVITY_RANGE",
   "SENSOR_SENSITIVITY",
   "CameraCharacteristics",
   "Range<Integer>"
  ],
  "product": [
   "getSupportedIsoRange",
   "setIso",
   "getIso",
   "ManualIso",
   "filter",
   "sort"
  ]
 },
 "probe": {
  "pattern": "getSupportedIsoRange\\(\\)\\s*\\[\\s*[01]\\s*\\]|iso\\[0\\][^\\n]{0,40}iso\\[1\\]",
  "note": "直接取 ISO 列表的前两项当上下限；应过滤正值排序后取首尾"
 },
 "unverified": [
  "本机 SDK 是 API 23，没有 ManualIso 的声明，按文档副本核"
 ],
