{
 "id": "rule-ac7b8cafa11b",
 "title": "TableLayout 的 stretchColumns/shrinkColumns 不是等分，按自然宽加均分余量算列宽",
 "product": "代码",
 "triggers": [
  {
   "read": "源布局 `TableLayout` 带 `android:stretchColumns=\"*\"` / `android:shrinkColumns=\"*\"`，单元格有 paddingStart / paddingEnd",
   "wrong": "目标每行用两个 `.layoutWeight(1)` 或 `.width('50%')` 等分列宽"
  }
 ],
 "scope": "源端 TableLayout 用 stretchColumns / shrinkColumns 分配列宽，迁到 ArkUI 行列布局时",
 "exceptions": [],
 "how": [
  {
   "text": "先求每列最宽单元格的自然宽：文字宽用 this.getUIContext().getMeasureUtils().measureText({ textContent, fontSize, … }) 测（返回 px），再加单元格左右 padding；或用 onAreaChange 取单元格实际宽",
   "support": [
    "case-9cfde635e67a08373fe6#recommendation:4",
    "case-9cfde635e67a08373fe6#diagnosis"
   ]
  },
  {
   "text": "列宽 = 该列自然宽 + (行宽 − 各列自然宽之和) / 可伸缩列数；余量为负且列可收缩时同样按列数均摊减少",
   "support": [
    "case-9cfde635e67a08373fe6#recommendation:4"
   ]
  }
 ],
 "values": [
  {
   "value": "列宽由该列最宽的单元格决定；stretchable 的列扩展以填满剩余空间，shrinkable 的列收缩以放进父容器",
   "meaning": "TableLayout 列宽的语义",
   "source": "android.widget.TableLayout 类注释",
   "support": []
  },
  {
   "value": "extraSpace = (size - totalWidth) / count；maxWidths[i] += extraSpace",
   "meaning": "余量（可为负）按列数均分加到每列的自然宽上",
   "source": "android.widget.TableLayout#mutateColumnsWidth",
   "support": []
  },
  {
   "value": "measureText(options: MeasureOptions): number，返回 px",
   "meaning": "测文字自然宽",
   "source": "鸿蒙 SDK 的 ets/api/@ohos.arkui.UIContext.d.ts，MeasureUtils.measureText、UIContext.getMeasureUtils",
   "support": []
  },
  {
   "value": "measureTextSize(options: MeasureOptions): SizeOptions",
   "meaning": "同族接口：MeasureUtils.measureTextSize，同时测宽高",
   "source": "鸿蒙 SDK 的 ets/api/@ohos.arkui.UIContext.d.ts，MeasureUtils.measureTextSize",
   "support": []
  },
  {
   "value": "用 measureText 测最宽标签和数值后按 TableLayout 公式分配，列宽与源端一致",
   "meaning": "验证过的做法",
   "source": "卡里修好并验证过",
   "support": [
    "case-9cfde635e67a08373fe6#diagnosis"
   ]
  }
 ],
 "lookups": [],
 "why": "直接等分时文字短的列占了多余宽度，列宽和源端不同",
