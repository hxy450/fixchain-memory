{
 "id": "rule-460f46c437f3",
 "title": "规格判定「编辑态无可点击 span」前先查 RichEditor 声明，替代通道标为行为差异",
 "product": "规格",
 "triggers": [
  {
   "read": "安卓源用三方 EditText 在编辑态给正文内的链接加可点击 span（如 gatherLinksForText + setOnTextLinkClickListener）",
   "wrong": "规格断言「ArkUI TextInput/TextArea 不支持编辑态内嵌可点击 span」「RichText 只读」，据此登记决策改走替代通道（如长按 → 解析全文 → 动作列表），映射行仍标 HARD 行为等价"
  }
 ],
 "scope": "规格提取阶段，给源端二进制依赖的三方控件判定目标端有无等价能力时",
 "exceptions": [],
