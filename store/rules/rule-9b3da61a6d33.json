{
 "id": "rule-9b3da61a6d33",
 "title": "浮层关闭动画按触发源传时长，手势收起和自动出场不共用一个硬编码时长",
 "product": "代码",
 "triggers": [
  {
   "read": "源端上滑超过阈值时 cancel() 主动画，改播另一个 setDuration(...) 不同的 Animator",
   "wrong": "dismiss() 里固定 animateTo({ duration: 300 }, …)，PanGesture 上滑和定时自动出场都调它"
  }
 ],
 "scope": "把源端横幅、浮层窗口的多组动画迁成 ArkUI 显式动画时",
 "exceptions": [],
 "how": [
  {
   "text": "关闭写成 dismiss(duration: number)：上滑手势传源端手势分支 Animator 的时长，自动出场传出场时长",
   "support": [
    "case-0a19acd6cfea1aafecbe#recommendation:4",
    "case-0a19acd6cfea1aafecbe#diagnosis"
   ]
  },
  {
   "text": "对照源码 getView / setView / 触摸回调逐项核对摘要规格有没有漏掉可见行为；漏了就实现，或在交接里列为差异",
   "support": [
    "case-0a19acd6cfea1aafecbe#recommendation:3"
   ]
  }
 ],
 "values": [
  {
   "value": "animateTo(value: AnimateParam, event: () => void): void",
   "meaning": "UIContext 上的显式动画，时长由 AnimateParam.duration 传",
   "source": "鸿蒙 SDK 的 ets/api/@ohos.arkui.UIContext.d.ts，UIContext.animateTo",
   "support": []
  },
  {
   "value": "AnimateParam.duration：Animation duration, in ms，@default 1000",
   "meaning": "单位毫秒，和源端 setDuration 同单位，可照搬",
   "source": "鸿蒙 SDK 的 ets/component/common.d.ts，AnimateParam.duration",
   "support": []
  },
  {
   "value": "全局 animateTo：@deprecated since 18，@useinstead UIContext#animateTo",
   "meaning": "新写的代码用 UIContext 上的那个",
   "source": "鸿蒙 SDK 的 ets/component/common.d.ts，animateTo",
   "support": []
  },
  {
   "value": "改成 dismiss(duration)、上滑传手势分支的时长后，退出时长和源端一致",
   "meaning": "修好的写法",
   "source": "卡里修好并验证过",
   "support": [
    "case-0a19acd6cfea1aafecbe#diagnosis"
   ]
  }
 ],
 "lookups": [],
