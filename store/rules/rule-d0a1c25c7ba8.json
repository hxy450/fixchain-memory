{
 "id": "rule-d0a1c25c7ba8",
 "title": "V2 组件里 @Event、@Local、@Param 等裸写，不带括号；只有工厂装饰器带括号",
 "product": "代码",
 "triggers": [
  {
   "read": "派工或规格写「装饰器锁 V2（@ComponentV2 / @Local / @Param / @Event / …）」，组件要向宿主暴露交互回调",
   "wrong": "@ComponentV2 组件里写出 @Event()、@Local()、@Param() 这类带空括号的成员装饰器；编译报 Expected 2 arguments, but got 0"
  }
 ],
 "scope": "在 @ComponentV2 自定义组件里声明 @Event 回调和 @Local / @Param / @Once / @Trace 成员时",
 "exceptions": [],
 "how": [
  {
   "text": "@Local / @Param / @Once / @Event / @Trace 裸写（如 @Event onToggle: () => void = () => {}）；只有 @Provider() / @Consumer()、@Monitor('…') 这类工厂装饰器带括号",
   "support": [
    "case-d33b282e5bf383e03328#recommendation:1",
    "case-d33b282e5bf383e03328#diagnosis"
   ]
  }
 ],
 "values": [
  {
   "value": "declare const Event: PropertyDecorator;",
   "meaning": "@Event 本身就是属性装饰器，加括号等于把它当函数调用",
   "source": "鸿蒙 SDK 的 ets/component/common.d.ts，Event",
   "support": []
  },
  {
   "value": "declare const Local: PropertyDecorator; declare const Param: PropertyDecorator;",
   "meaning": "@Local、@Param 同样裸写",
   "source": "鸿蒙 SDK 的 ets/component/common.d.ts，Local、Param",
   "support": []
  },
  {
   "value": "declare const Provider: (aliasName?: string) => PropertyDecorator;",
   "meaning": "@Provider 是工厂，要写 @Provider()；@Consumer 同形",
   "source": "鸿蒙 SDK 的 ets/component/common.d.ts，Provider、Consumer",
   "support": []
  },
  {
   "value": "declare type MonitorDecorator = (value: string, ...args: string[]) => MethodDecorator;",
   "meaning": "@Monitor 要带被监听的路径，写 @Monitor('…')",
   "source": "鸿蒙 SDK 的 ets/component/common.d.ts，MonitorDecorator",
   "support": []
  }
 ],
