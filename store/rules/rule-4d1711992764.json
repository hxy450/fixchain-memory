 "lookups": [],
 "why": "应用串和框架串在各语言的译法不同，借应用的同名键会让按钮文案和原版不一致",
 "keys": {
  "read": [
   "ListPreference",
   "EditTextPreference",
   "DialogPreference",
   "android:positiveButtonText",
   "android:negativeButtonText",
   "@android:string/ok",
   "@android:string/cancel"
  ],
  "product": [
   "$r('app.string.cancel')",
   "$r('app.string.confirm')",
   "android_ok",
   "android_cancel",
   "AlertDialog",
   "CustomDialog"
  ]
 },
 "probe": {
  "pattern": "\\$r\\('app\\.string\\.(?:cancel|confirm|ok)'\\)",
  "note": "按钮引用应用的 ok/cancel/confirm；若源端按钮是框架默认文案，应改用框架译文资源"
 },
