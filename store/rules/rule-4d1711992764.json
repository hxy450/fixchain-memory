{
 "id": "rule-4d1711992764",
 "title": "偏好对话框没声明按钮文案时引用框架译文资源，不借应用同名的 ok、cancel、confirm",
 "product": "代码",
 "triggers": [
  {
   "read": "<ListPreference> / <EditTextPreference> 只有 entries、entryValues、key、title、dialogTitle，没有 android:positiveButtonText / android:negativeButtonText",
   "wrong": "对应弹层的按钮写 $r('app.string.cancel')、$r('app.string.confirm') 这类应用字符串"
  }
 ],
 "scope": "源端 Preference、AlertDialog 的默认按钮文案（应用没显式声明）迁到目标对话框时",
 "exceptions": [],
 "how": [
  {
   "text": "按钮引用从框架译文落成的资源（如 $r('app.string.android_ok')、$r('app.string.android_cancel')），不因应用恰好有同名键就引用应用串",
   "support": [
    "case-4975883d1d11fd0cde40#recommendation:3",
    "case-4975883d1d11fd0cde40#diagnosis"
   ]
  },
  {
   "text": "最小检查：对照源 XML 有没有 positiveButtonText / negativeButtonText，有就用它引用的字符串",
   "support": [
    "case-4975883d1d11fd0cde40#recommendation:3"
   ]
  }
 ],
 "values": [
  {
   "value": "Preference.DialogPreference 样式：android:positiveButtonText = @android:string/ok，android:negativeButtonText = @android:string/cancel",
   "meaning": "androidx.preference 的默认按钮文案来自框架",
   "source": "androidx.preference:preference 包内 res/values/values.xml，Preference.DialogPreference（按应用依赖的版本）",
   "support": []
  },
  {
   "value": "Preference.DialogPreference 样式：positiveButtonText = @string/ok，negativeButtonText = @string/cancel",
   "meaning": "平台 android.preference 的默认按钮文案",
   "source": "Android SDK 平台资源 data/res/values/styles.xml，Preference.DialogPreference（按应用的 compileSdk 取对应平台）",
   "support": []
  },
  {
   "value": "返修把按钮改成 android_cancel / android_ok",
