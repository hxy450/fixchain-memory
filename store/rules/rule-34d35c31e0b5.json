{
 "id": "rule-34d35c31e0b5",
 "title": "窗口级属性在 onWindowStageCreate 取到主窗口后执行，不靠 getLastWindow",
 "product": "代码",
 "triggers": [
  {
   "read": "源端在组合期由 LocalView 取 Activity window，再设 FLAG_SECURE 和 isAppearanceLightStatusBars，此时窗口已存在",
   "wrong": "主题服务用 window.getLastWindow(context) 取窗口设状态栏极性或隐私窗，HANDOFF 写 owner=EntryAbility.onCreate，onWindowStageCreate 里没有注入主窗口"
  }
 ],
 "scope": "目标端在 EntryAbility 启动链里设置窗口级属性（系统栏属性、隐私窗）时",
 "exceptions": [],
 "how": [
  {
   "text": "在 onWindowStageCreate(windowStage) 里用 windowStage.getMainWindowSync() 取主窗口注入主题服务，再执行或补执行 setWindowSystemBarProperties / setWindowPrivacyMode",
   "support": [
    "case-b3c176b95cabcc03a434#recommendation:6",
    "case-b3c176b95cabcc03a434#diagnosis"
   ]
  },
  {
   "text": "交到 onCreate 的服务不依赖 getLastWindow 取窗口；在 onConfigurationUpdate 里按新主题重新下发，并加重入保护",
   "support": [
    "case-b3c176b95cabcc03a434#recommendation:6",
    "case-b3c176b95cabcc03a434#diagnosis"
   ]
  }
 ],
