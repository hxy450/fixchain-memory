{
 "id": "rule-17f05e899c11",
 "title": "源内容区 wrap_content 自上而下排列时，目标分了高也设 FlexAlign.Start",
 "product": "代码",
 "triggers": [
  {
   "read": "显示卡片 android:layout_height=\"wrap_content\"，里面输入框在上、结果在下自上而下排列，带 paddingVertical",
   "wrong": "目标显示卡片用 .layoutWeight(1) 撑高，内容列写 .justifyContent(FlexAlign.End) 只给 bottom 内边距，数值贴在显示区底部"
  }
 ],
 "scope": "源端内容区是 wrap_content、子项从顶部排起，目标为了分高给容器加了 layoutWeight 或固定高度时",
 "exceptions": [],
 "how": [
  {
   "text": "内容列写 .justifyContent(FlexAlign.Start)，保持源的子项顺序，并沿用源的上内边距（如 paddingVertical 写成 .padding({ top: n, bottom: n })）",
   "support": [
    "case-639b36918b1cd5c1bbe8#recommendation:2",
    "case-639b36918b1cd5c1bbe8#diagnosis"
   ]
  }
 ],
 "values": [
