{
 "id": "rule-13ca2e2e51cd",
 "title": "contains/endsWith/startsWith 没传 ignoreCase 时，目标保持大小写敏感",
 "product": "代码",
 "triggers": [
  {
   "read": "Kotlin 源码里 `contains(\"…\")`、`endsWith(\".ext\")`、`startsWith(\"…\")` 没有传 `ignoreCase = true`，前面也没有 `lowercase()`",
   "wrong": "目标端写成 `s.toLowerCase().indexOf('…') >= 0`、`name.toLowerCase().endsWith('.ext')`，自行加了大小写归一"
  }
 ],
 "scope": "把 Kotlin 源码里的字符串匹配、筛选表达式翻译成 ArkTS 判定时",
 "exceptions": [],
 "how": [
  {
   "text": "按源 API 的默认语义写大小写敏感的判定：contains(\"x\") → s.includes('x')，endsWith(\".ext\") → name.endsWith('.ext')，startsWith(\"x\") → s.startsWith('x')，不加 toLowerCase()",
   "support": [
    "case-63ee0b9d164865f45abd#recommendation:1",
    "case-63ee0b9d164865f45abd#diagnosis"
   ]
  },
  {
   "text": "只有源码本身调用了 lowercase() 或传了 ignoreCase = true 时，目标端才做大小写归一",
   "support": [
    "case-63ee0b9d164865f45abd#recommendation:1"
   ]
  }
 ],
