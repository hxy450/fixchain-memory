 "product": "代码",
 "triggers": [
  {
   "read": "getStringSync 或 $r 读回的字符串值首尾带字面双引号，或残留反斜杠，源 strings.xml 里对应的 <string> 是用双引号包着或带转义的",
   "wrong": "页面代码在 getStringSync(...) 的结果上再剥一层引号或去反斜杠（自写的取值辅助函数、.replace(...)、首尾截取）"
  }
 ],
 "scope": "界面实现阶段读回字符串资源显示或拼接时",
 "exceptions": [],
 "how": [
  {
   "text": "对照源 strings.xml 确认是 aapt 的外层引号或转义后，回到各 locale 的 element/string.json 改值（去掉外层引号、还原转义），页面直接使用 getStringSync / $r 的结果，不加剥除逻辑",
   "support": [
    "case-59da3f8259cbad8d67c1#recommendation:3"
   ]
  }
 ],
