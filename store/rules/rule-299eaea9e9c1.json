{
 "id": "rule-299eaea9e9c1",
 "title": "框架溢出面板按源主题的溢出菜单样式和弹层底色定位置与颜色，Material 系盖住标题栏",
 "product": "代码",
 "triggers": [
  {
   "read": "源主题是 Theme.Material 系（如 Theme.Material.Light.DarkActionBar）的窗口 ActionBar，菜单有进溢出的项",
   "wrong": "溢出面板 margin top 等于栏高、贴在标题栏下，底色写成 #FFFFFFFF 纯白"
  }
 ],
 "scope": "自绘标题栏还原框架窗口 ActionBar 的溢出面板时",
 "exceptions": [
  {
   "text": "源主题是 Holo 系时，溢出菜单样式没有 overlapAnchor，面板贴栏下沿",
   "support": [
    "case-45b40cf92799928188ab#recommendation:2"
   ]
  }
 ],
 "how": [
  {
   "text": "按源主题的 actionOverflowMenuStyle 取锚定：Material 系 overlapAnchor=true，面板盖住标题栏，水平按 dropDownHorizontalOffset −4dip 偏移",
   "support": [
    "case-45b40cf92799928188ab#recommendation:5",
    "case-45b40cf92799928188ab#recommendation:2"
   ]
  },
  {
   "text": "底色取 colorPopupBackground 的解析值：Material.Light 为 ?attr/colorBackground → #FFFAFAFA，不是纯白",
   "support": [
    "case-45b40cf92799928188ab#recommendation:2",
    "case-45b40cf92799928188ab#diagnosis"
   ]
  }
 ],
 "values": [
  {
   "value": "Widget.Material.PopupMenu.Overflow：overlapAnchor=true，dropDownHorizontalOffset=-4dip",
   "meaning": "Material 溢出面板盖住锚点（标题栏）",
   "source": "Android SDK 平台资源 data/res/values/styles_material.xml，Widget.Material.PopupMenu.Overflow（按应用的 compileSdk 取对应平台）",
   "support": []
  },
  {
   "value": "Theme.Material.Light：actionOverflowMenuStyle=@style/Widget.Material.Light.PopupMenu.Overflow（parent 是 Widget.Material.PopupMenu.Overflow）",
   "meaning": "浅色 Material 主题用的溢出菜单样式",
   "source": "Android SDK 平台资源 data/res/values/themes_material.xml，Theme.Material.Light；styles_material.xml，Widget.Material.Light.PopupMenu.Overflow",
   "support": []
  },
  {
   "value": "Theme.Material.Light：colorPopupBackground=?attr/colorBackground，colorBackground=@color/background_material_light → material_grey_50 = #fffafafa",
   "meaning": "弹层底色",
   "source": "Android SDK 平台资源 data/res/values/themes_material.xml，Theme.Material.Light；data/res/values/colors_material.xml，background_material_light、material_grey_50",
   "support": []
  },
  {
   "value": "面板改为盖住标题栏、底色 #FFFAFAFA、带投影后与安卓实测一致",
