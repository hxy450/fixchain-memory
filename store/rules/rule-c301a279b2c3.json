  }
 ],
 "scope": "安卓 Canvas 文字迁到 ArkUI Canvas，应用可能在 RTL 系统语言（含没有对应资源、回落英文的语言）下运行时",
 "exceptions": [],
 "how": [
  {
   "text": "写一个绘制函数：取串里首个强方向字符，落在希伯来、阿拉伯字符区块设 ctx.direction = 'rtl'，其他字母设 'ltr'，没有字母设 'ltr'，然后再 ctx.fillText；所有 fillText 都改调它",
   "support": [
    "case-e485c29b5b8cabfc9f01#diagnosis",
    "case-e485c29b5b8cabfc9f01#recommendation:1"
   ]
  },
  {
   "text": "判断字符区块的正则用 \\u 转义写码位，不在源码里直接写 RTL 字符",
   "support": [
    "case-e485c29b5b8cabfc9f01#diagnosis"
   ]
  }
 ],
