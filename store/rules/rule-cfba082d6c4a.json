{
 "id": "rule-cfba082d6c4a",
 "title": "源码混用 Toast 的 SHORT 和 LONG 时，Toast 封装带 duration 参数、逐处照源映射",
 "product": "代码",
 "triggers": [
  {
   "read": "源码 Toast.makeText(…, Toast.LENGTH_SHORT) 和 Toast.LENGTH_LONG 在同一文件或同一公共方法里混用",
   "wrong": "目标 showToast({ message, duration }) 全部用同一个时长（如只定义一个 LONG 常量 3500），或公共 Toast 封装只有 message 参数、duration 写死"
  }
 ],
 "scope": "把源端 Toast.makeText 调用翻译成目标公共 Toast 封装或 showToast 调用时",
 "exceptions": [],
 "how": [
