# Only durable knowledge and the current reading package are published.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/MEMORY.md
!/store/
/store/*
!/store/HEAD.json
!/store/cases/
!/store/snapshots/
/store/cases/*
!/store/cases/*/
/store/cases/*/*
!/store/cases/*/*.json
/store/snapshots/*
!/store/snapshots/*.json
!/memory/
# runs/, local pointers, control metadata and transient outputs stay local.
**/__pycache__/
**/*.pyc
**/*.tmp
**/*.sqlite*
**/*.db*
**/*.log
**/*.partial
**/.publish.lock
