# Only durable knowledge and the current reading package are published.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/MEMORY.md
!/store/
/store/*
!/store/HEAD.json
!/store/cases/
!/store/snapshots/
/store/cases/*
!/store/cases/*/
/store/cases/*/*
!/store/cases/*/*.json
/store/snapshots/*
!/store/snapshots/*.json
!/memory/
# rules v2 (docs/rules-v2-design.md): the design doc, the memory-rules skill and its outputs; work/ holds intermediate files
!/docs/
!/skills/
!/rules/
!/store/candidates/
!/store/reviews/
!/store/merge/
!/store/rules/
!/store/families/
/work/
# runs/, local pointers, control metadata and transient outputs stay local.
**/__pycache__/
**/*.pyc
**/*.tmp
**/*.sqlite*
**/*.db*
**/*.log
**/*.partial
**/.publish.lock
