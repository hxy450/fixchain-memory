# Durable memory artifacts only. Raw transcripts / indexes / scratch drafts stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/SEED.json
!/LATEST.json
!/MEMORY.md
!/PIPELINE.json
!/store/
/store/*
!/store/HEAD.json
!/store/cases/
!/store/snapshots/
/store/cases/*
!/store/cases/*/
/store/cases/*/*
!/store/cases/*/*.json
/store/snapshots/*
!/store/snapshots/*.json
!/runs/
/runs/*
!/runs/*/
/runs/*/*
!/runs/*/REPORT.md
!/runs/*/repair-tasks.yaml
!/runs/*/server-metadata.json
!/runs/*/revisions.json
!/runs/*/completion.json
!/runs/*/batch-result.json
!/runs/*/proposals/
/runs/*/proposals/*
!/runs/*/proposals/*.yaml
!/runs/*/memory*/
# Native temporary/lock files are never evidence.
**/__pycache__/
**/*.pyc
**/*.tmp
**/*.sqlite*
**/*.db*
**/*.log
**/*.partial
**/.publish.lock
