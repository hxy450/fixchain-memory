 "entries": [
  {
   "step": "做法第 2 步",
   "fact": "Scroller.currentOffset() 在 Scroller 没有绑定到组件时返回空；返回的 OffsetResult.yOffset 是竖直滑动偏移，单位 vp",
   "source": "鸿蒙 SDK 的 ets/component/scroll.d.ts，Scroller.currentOffset；https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-container-scroll.md，OffsetResult",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 3、5 步",
   "fact": "List.onScrollFrameBegin 回调传入即将发生的滑动量，列表按回调返回的 offsetRemain 实际滑动；listDirection 为 Axis.Vertical 时是垂直方向的量；传入的 offset 单位 vp",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-container-list.md，onScrollFrameBegin；鸿蒙 SDK 的 ets/component/scroll.d.ts，OnScrollFrameBeginCallback、OnScrollFrameBeginHandlerResult.offsetRemain",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 3、5 步",
   "fact": "List.onScrollFrameBegin 只在用户交互（手指滑动、键鼠操作等）、惯性滚动和调用 fling 时触发；调用 fling 以外的滚动控制接口（如 scrollTo、scrollToIndex）、越界回弹、拖动滚动条时不触发",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-container-list.md，onScrollFrameBegin",
   "kind": "鸿蒙接口",
   "origin": "新查"
  }
 ],
