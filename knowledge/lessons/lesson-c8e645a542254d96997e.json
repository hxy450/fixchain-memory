  "docs_date": "2026-11-21",
  "harmony": "HarmonyOS 6.1.0（API 23，SDK 6.1.0.105）",
  "android": "android-36.1 的源码"
 },
 "changes": [],
 "entries": [
  {
   "step": "原因",
   "fact": "鸿蒙应用资源的资源组目录只有 element、media、profile 三类，没有和安卓 res/layout 对应的布局资源组",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/quick-start/resource-categories-and-access.md，资源分类",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "安卓 Configuration.smallestScreenWidthDp 对应 sw 限定符，取竖屏和横屏两种方向下 screenWidthDp、screenHeightDp 的最小值，不随旋转变化",
   "source": "android.content.res.Configuration#smallestScreenWidthDp",
   "kind": "安卓平台",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "安卓 screenWidthDp、screenHeightDp 在应用 targetSdk 为 35（VANILLA_ICE_CREAM）及以上时等于 WindowMetrics 的窗口尺寸（含系统栏等插入区）取整到 dp；targetSdk 低于 35 时不含窗口插入区占用的部分",
   "source": "android.content.res.Configuration#screenWidthDp；android.content.res.Configuration#screenHeightDp",
   "kind": "安卓平台",
   "origin": "新查"
  },
  {
   "step": "做法第 1 步",
   "fact": "窗口 Rect 的 width、height 单位是 px",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkts-apis-window-i.md，Rect",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "媒体查询比较 width、height 等数值型媒体特征时支持 vp 和 px 单位，不写单位时按 px",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/ui/arkts-layout-development-media-query.md，媒体特征（media-feature）",
   "kind": "鸿蒙接口",
   "origin": "新查"
  },
  {
   "step": "做法第 2 步",
   "fact": "安卓 setBackgroundResource 只给调用它的那个 View 取新 drawable 并 setBackground，不影响其他控件",
   "source": "android.view.View#setBackgroundResource",
   "kind": "安卓平台",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 2 步",
   "fact": "安卓 ColorDrawable 用指定颜色填满整个画布，没有圆角；XML 里对应 <color> 元素",
   "source": "android.graphics.drawable.ColorDrawable",
   "kind": "安卓平台",
   "origin": "沿用并复核"
  }
 ],
