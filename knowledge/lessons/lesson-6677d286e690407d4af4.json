 "entries": [
  {
   "step": "原因",
   "fact": "hitTestBehavior 设为 HitTestMode.None 的节点自身不响应触摸测试（不阻塞子节点、兄弟节点和祖先节点），绑在这个节点自身上的点击和手势随之都收不到事件",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-appendix-enums.md，HitTestMode；鸿蒙 SDK 的 ets/component/enums.d.ts，HitTestMode",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "HitTestMode.Block：节点自身响应触摸测试，并阻塞子节点、兄弟节点和祖先节点的触摸测试",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-appendix-enums.md，HitTestMode",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "Stack 中多个节点的触摸区域重叠、且最上层节点的子组件命中时，默认只对显示在最上层的节点做触摸测试；只有给最上层节点设 HitTestMode.Transparent，下层节点才参与触摸测试",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-appendix-enums.md，HitTestMode",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  }
 ],
