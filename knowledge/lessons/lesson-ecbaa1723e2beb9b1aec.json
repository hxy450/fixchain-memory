 "entries": [
  {
   "step": "原因",
   "fact": "Resources.getString(id, formatArgs) 先取出资源串，再以当前配置的首选 Locale 调 String.format 代入参数；%s、%1$s 这类格式符把参数的字符串形式直接插入，不解释其中的 $ 等字符",
   "source": "android.content.res.Resources#getString",
   "kind": "安卓平台",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "String.prototype.replace 的回调重载（第二个参数是函数）用回调的返回值作为替换文本",
   "source": "鸿蒙 SDK 的 ets/build-tools/ets-loader/node_modules/typescript/lib/lib.es5.d.ts，String.replace",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "resourceManager 的 getStringSync(resId, ...args)（API 10 起）按 %d、%f、%s、%%、%数字$d、%数字$f、%数字$s 格式化资源串：%1$s 取 args[0]，依此类推；%% 转义为 %",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-localization-kit/js-apis-resource-manager.md，getStringSync",
   "kind": "鸿蒙接口",
   "origin": "新查"
  }
 ],
