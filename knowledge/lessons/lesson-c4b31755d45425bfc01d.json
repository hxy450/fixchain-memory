 "entries": [
  {
   "step": "原因",
   "fact": "状态管理 V2 给 @Trace、@Local 装饰的 Date、Map、Set、Array 添加一层代理，用于观测 API 调用产生的变化",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/ui/state-management/arkts-new-getTarget.md，概述",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "UIUtils.getTarget(source) 取得状态管理代理前的原始对象（API 12 起）；只支持对象类型入参",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/ui/state-management/arkts-new-getTarget.md，限制条件；鸿蒙 SDK 的 ets/api/@ohos.arkui.StateManagement.d.ts，UIUtils.getTarget",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "更改 getTarget 取得的原始对象中的内容不会被观察到变化，也不会触发 UI 刷新",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/ui/state-management/arkts-new-getTarget.md，限制条件",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "原因",
   "fact": "卡里设备上，定时器回调里逐格读 V2 可观察二维数组时单代同步计算约十几到二十多毫秒，同样的计算读 getTarget 取得的原始数组时约 2–5 毫秒；回调里的同步耗时直接叠加到定时间隔上",
   "source": "卡里上机实测（case-31dcdb74eb848ff217c8，打点计时）",
   "kind": "卡里验证",
   "origin": "沿用并复核"
  }
 ],
