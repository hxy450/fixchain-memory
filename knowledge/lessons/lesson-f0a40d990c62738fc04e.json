 "entries": [
  {
   "step": "适用情境 / 做法第 1 步",
   "fact": "Scroller.scrollToIndex 的 smooth 不写时为 false（无动画）；align 不写时，容器是 List 或 WaterFlow 为 ScrollAlign.START",
   "source": "鸿蒙 SDK 的 ets/component/scroll.d.ts，Scroller.scrollToIndex；https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-container-scroll.md，scrollToIndex",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "原因 / 做法第 1 步",
   "fact": "ScrollAlign：START 使目标 item 首部与滚动容器首部对齐；CENTER 使 item 在主轴方向居中；END 使 item 尾部与容器尾部对齐；AUTO 在 item 已完全处于显示区时不调整，否则按滑动距离最短的原则首部或尾部对齐",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-container-scroll.md，ScrollAlign；鸿蒙 SDK 的 ets/component/scroll.d.ts，ScrollAlign",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "scrollToIndex 的 options 是 ScrollToIndexOptions（API 12 起），其中 extraOffset（LengthMetrics）是滑到指定 index 后的额外偏移：正数向底部、负数向顶部",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-container-scroll.md，ScrollToIndexOptions",
   "kind": "鸿蒙接口",
   "origin": "新查"
  }
 ],
