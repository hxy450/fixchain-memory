 "changes": [],
 "entries": [
  {
   "step": "原因 / 做法第 1 步",
   "fact": "width、height 等尺寸属性传 number 时单位是 vp（.width(21845) 即 21845vp）",
   "source": "鸿蒙 SDK 的 ets/component/common.d.ts，CommonMethod.width；https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-universal-attributes-size.md，width",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "原因",
   "fact": "Length 的 string 写法要显式带像素单位（如 '10px'）或写百分比；不带单位时默认按 vp",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-types.md，Length",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 4 步",
   "fact": "px 是屏幕物理像素；vp 按屏幕像素密度换算成物理像素，数值不带单位时默认 vp",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-pixel-units.md，像素单位",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 4 步",
   "fact": "VectorDrawable 根元素的 android:width、android:height 是它的固有宽高",
   "source": "Android SDK 平台资源 data/res/values/attrs.xml，VectorDrawable",
   "kind": "安卓平台",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 4 步",
   "fact": "安卓资源的密度值为 TypedValue.DENSITY_DEFAULT（0）时，按系统默认密度 DisplayMetrics.DENSITY_DEFAULT（即 DENSITY_MEDIUM，160dpi，1x）处理",
   "source": "android.util.TypedValue#DENSITY_DEFAULT；android.util.DisplayMetrics#DENSITY_DEFAULT",
   "kind": "安卓平台",
   "origin": "新查"
  }
 ],
