  {
   "step": "适用情境 / 做法第 1 步",
   "fact": "RdbStore.update(values, predicates) 和 RdbStore.delete(predicates) 的 Promise 兑现值是受影响的行数；executeSql 的 Promise 不带返回值",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkdata/arkts-apis-data-relationalStore-RdbStore.md，update；https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkdata/arkts-apis-data-relationalStore-RdbStore.md，delete；鸿蒙 SDK 的 ets/api/@ohos.data.relationalStore.d.ts，RdbStore.executeSql",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "原因",
   "fact": "单测中用 RdbStore.executeSql 执行 UPDATE，随后用 querySql('SELECT changes()') 读行数，数据已经写入，读到的行数却是 0",
   "source": "卡里修好并验证过（case-e6ec1491a065e800a4f8）",
   "kind": "卡里验证",
   "origin": "沿用并复核"
  }
