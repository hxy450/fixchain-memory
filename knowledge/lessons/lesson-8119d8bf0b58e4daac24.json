 "changes": [],
 "entries": [
  {
   "step": "做法第 7 步",
   "fact": "clip 没有设置时不裁剪子组件超出本组件范围的部分；设为 true 后，子组件超出本组件范围的区域也不响应绑定的手势",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-universal-attributes-sharp-clipping.md，clip；鸿蒙 SDK 的 ets/component/common.d.ts，CommonMethod.clip",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 2 步",
   "fact": "安卓属性取值按先后：控件 AttributeSet 里直接写的值 → AttributeSet 里 style 指定的样式 → defStyleAttr、defStyleRes → 主题，排在前面的优先",
   "source": "android.content.res.Resources.Theme#obtainStyledAttributes",
   "kind": "安卓平台",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1 步",
   "fact": "Text 的 fontSize 传 number 时单位是 fp，不设时为 16fp（Wearable 设备上 15fp）",
   "source": "鸿蒙 SDK 的 ets/component/text.d.ts，TextAttribute.fontSize",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1、2 步",
   "fact": "鸿蒙 float 资源写在 float.json 里，每项的数值和单位只在 value 里（如 \"28.0fp\"），资源名不代表数值",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/quick-start/resource-categories-and-access.md，资源文件示例",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 1、2 步",
   "fact": "安卓 DENSITY_MEDIUM（即 DENSITY_DEFAULT）是 160、DENSITY_XHIGH 是 320、DENSITY_XXHIGH 是 480；dp = px × 160 / dpi，同一 dp 在不同密度设备上截图像素不同",
   "source": "android.util.DisplayMetrics#DENSITY_MEDIUM；android.util.DisplayMetrics#DENSITY_XHIGH；android.util.DisplayMetrics#DENSITY_XXHIGH；android.util.DisplayMetrics#DENSITY_DEFAULT",
   "kind": "安卓平台",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 2 步",
   "fact": "ImageFit.Fill 不保持宽高比缩放，使图片填满显示边界",
   "source": "鸿蒙 SDK 的 ets/component/enums.d.ts，ImageFit.Fill",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 2 步",
   "fact": "安卓 ImageView 的 scaleType 取值 fitXY = 1，X、Y 各自缩放填满",
   "source": "Android SDK 平台资源 data/res/values/attrs.xml，scaleType",
   "kind": "安卓平台",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 8 步",
   "fact": "if、else if 的条件可以用状态变量或常规变量：状态变量的值改变时实时重新渲染，常规变量的值改变不会",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/ui/rendering-control/arkts-rendering-control-ifelse.md，使用规则",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  }
 ],
