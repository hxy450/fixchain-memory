 "changes": [],
 "entries": [
  {
   "step": "原因 / 做法第 1 步",
   "fact": "ConstraintLayout 的 layout_constraintTop_toBottomOf 属性格式是 reference|enum：取兄弟视图 id 时锚兄弟，取 parent 时锚父容器",
   "source": "androidx.constraintlayout:constraintlayout 2.2.2，包内 res/values/values.xml，layout_constraintTop_toBottomOf",
   "kind": "依赖库",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 2 步",
   "fact": "RelativeContainer 的子组件要有唯一的组件标识（id）才能被指定为锚点；父容器 RelativeContainer 的标识默认为 __container__",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/ui/arkts-layout-development-relative-layout.md，设置锚点",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 4 步",
   "fact": "Stack 不写 alignContent 时子组件按 Alignment.Center 居中叠放",
   "source": "鸿蒙 SDK 的 ets/component/stack.d.ts，StackOptions.alignContent",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 5 步",
   "fact": "Row 的 alignItems 不设时为 VerticalAlign.Center",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-container-row.md，alignItems；鸿蒙 SDK 的 ets/component/row.d.ts，RowAttribute.alignItems",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 5 步",
   "fact": "position 是相对父组件内容区的绝对定位；父组件为 Row、Column 或 Flex 时，设了 position 的子组件不占位",
   "source": "https://gitcode.com/openharmony/docs/blob/master/zh-cn/application-dev/reference/apis-arkui/arkui-ts/ts-universal-attributes-location.md，position；鸿蒙 SDK 的 ets/component/common.d.ts，CommonMethod.position",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  },
  {
   "step": "做法第 5 步",
   "fact": "offset 相对组件原位置偏移，只在绘制时调整位置，布局仍按原位置占位",
   "source": "鸿蒙 SDK 的 ets/component/common.d.ts，CommonMethod.offset",
   "kind": "鸿蒙接口",
   "origin": "沿用并复核"
  }
 ],
